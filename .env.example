# ---- general ----
ENVIRONMENT=production
LOG_LEVEL=INFO
# Public URL of the backend — VK Callback API sends events to ${PUBLIC_BASE_URL}/api/vk/callback/<id>
PUBLIC_BASE_URL=https://vk-panel.example.com
CORS_ORIGINS=http://localhost:3000

# ---- security (REQUIRED) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated: first key encrypts, all keys decrypt (rotation).
ENCRYPTION_KEYS=
# First owner account, created on the first start when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---- database ----
POSTGRES_USER=vk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vkreger

# ---- OpenAI ----
OPENAI_API_KEY=
# openai | fake (offline demo without API key)
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.4-mini
# JSON: per-operation models, e.g. {"project_setup":"gpt-5.4","inbox_triage":"gpt-5.4-nano"}
AI_MODEL_OVERRIDES={}
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDINGS_ENABLED=true
AI_SEPARATE_EDITOR_PASS=false
# JSON: USD per 1M tokens, overrides built-in defaults, e.g. {"gpt-5.4-mini":{"input":0.75,"cached_input":0.075,"output":4.5}}
AI_PRICING_JSON={}

# ---- images: openai | none | fake ----
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium

# ---- AI cost limits (USD) ----
MAX_AI_COST_PER_DAY=10
MAX_AI_COST_PER_PROJECT_DAY=2

# ---- VK ----
VK_API_VERSION=5.199

# ---- proxy checks ----
PROXY_CHECK_URL=http://ip-api.com/json/?fields=status,message,country,countryCode,query

# ---- notifications ----
# Optional: POST JSON to this URL for new leads / negative messages
OPERATOR_WEBHOOK_URL=
