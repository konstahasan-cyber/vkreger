#!/usr/bin/env bash
# Управление VKreger на сервере. Установка: ln -sf /opt/vkreger/deploy/vk /usr/local/bin/vk
set -euo pipefail
DIR="${VKREGER_DIR:-/opt/vkreger}"
cd "$DIR"
dc() { docker compose -f docker-compose.yml -f docker-compose.prod.yml "$@"; }
need_root() { if [ "$(id -u)" -ne 0 ]; then exec sudo -E "$0" "$@"; fi; }

case "${1:-help}" in
  update)  need_root "$@"; bash deploy/update.sh ;;
  restart) need_root "$@"; dc up -d; dc restart backend worker beat frontend; echo "Перезапущено." ;;
  start)   need_root "$@"; dc up -d; echo "Запущено: $(grep -m1 '^PUBLIC_BASE_URL=' .env | cut -d= -f2-)" ;;
  stop)    need_root "$@"; dc stop; echo "Остановлено. Данные сохранены." ;;
  status)  dc ps --format "table {{.Service}}\t{{.Status}}"; echo; echo "Адрес: $(grep -m1 '^PUBLIC_BASE_URL=' .env | cut -d= -f2-)" ;;
  logs)    dc logs --tail "${2:-100}" -f backend worker ;;
  backup)  need_root "$@"; bash deploy/backup.sh ;;
  env)     need_root "$@"; "${EDITOR:-nano}" .env; dc up -d; echo "Настройки применены." ;;
  port)    need_root "$@"
           [ -n "${2:-}" ] || { echo "Использование: vk port 8080"; exit 1; }
           sed -i '/^HTTP_PORT=/d' .env && echo "HTTP_PORT=$2" >> .env
           if grep -q '^SITE_ADDRESS=:80' .env; then sed -i '/^HTTPS_BIND=/d' .env && echo "HTTPS_BIND=127.0.0.1:8443" >> .env; fi
           ip=$(curl -fsS -4 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
           url="http://$ip"; [ "$2" = 80 ] || url="http://$ip:$2"
           sed -i '/^PUBLIC_BASE_URL=/d;/^CORS_ORIGINS=/d' .env && printf 'PUBLIC_BASE_URL=%s\nCORS_ORIGINS=%s\n' "$url" "$url" >> .env
           dc up -d --force-recreate caddy backend; echo "Панель теперь здесь: $url" ;;
  domain)  need_root "$@"
           d="${2:-}"; [ -n "$d" ] || { echo "Использование: vk domain panel.example.ru  (или vk domain off)"; exit 1; }
           sed -i '/^SITE_ADDRESS=/d;/^PUBLIC_BASE_URL=/d;/^CORS_ORIGINS=/d;/^HTTP_PORT=/d;/^HTTPS_BIND=/d' .env
           if [ "$d" = off ]; then
             ip=$(curl -fsS -4 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
             printf 'SITE_ADDRESS=:80\nPUBLIC_BASE_URL=http://%s:8080\nCORS_ORIGINS=http://%s:8080\nHTTP_PORT=8080\nHTTPS_BIND=127.0.0.1:8443\n' "$ip" "$ip" >> .env
             url="http://$ip:8080"
           else
             busy=$(ss -tlnpH '( sport = :80 or sport = :443 )' 2>/dev/null | grep -v docker-proxy || true)
             if [ -n "$busy" ]; then
               echo "Порты 80/443 заняты другой программой:"; echo "$busy"; echo "Освободите его (например: systemctl disable --now caddy) и повторите."; exit 1
             fi
             printf 'SITE_ADDRESS=%s\nPUBLIC_BASE_URL=https://%s\nCORS_ORIGINS=https://%s\nHTTP_PORT=80\nHTTPS_BIND=443\n' "$d" "$d" "$d" >> .env
             url="https://$d"
           fi
           dc up -d --force-recreate caddy backend worker beat
           echo "Панель: $url  (сертификат HTTPS получается автоматически, первая загрузка может занять до минуты)" ;;
  hostdomain) need_root "$@"
           # Use a Caddy that already owns 80/443 (systemd or another project's container) as the HTTPS front.
           port=$(grep -m1 '^HTTP_PORT=' .env | cut -d= -f2- || true); port=${port:-80}
           ip=$(curl -fsS -4 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')
           d="${2:-auto}"; [ "$d" = auto ] && d="$(echo "$ip" | tr . -).sslip.io"
           set +e
           if [ "$d" = off ]; then bash deploy/caddy-site.sh remove; else bash deploy/caddy-site.sh add "$d" "$port"; fi
           rc=$?; set -e
           if [ $rc = 3 ]; then echo "Не нашёл Caddy, который держит порты 80/443. Если порты свободны: vk domain $d"; exit 1; fi
           [ $rc = 0 ] || exit 1
           sed -i '/^PUBLIC_BASE_URL=/d;/^CORS_ORIGINS=/d' .env
           if [ "$d" = off ]; then url="http://$ip:$port"; [ "$port" = 80 ] && url="http://$ip"; else url="https://$d"; fi
           printf 'PUBLIC_BASE_URL=%s\nCORS_ORIGINS=%s\n' "$url" "$url" >> .env
           dc up -d --force-recreate backend worker beat >/dev/null
           echo "Готово. Панель: $url"
           [ "$d" != off ] && echo "Сертификат HTTPS получается автоматически — первая загрузка может занять до минуты." ;;
  doctor)
    echo "== Контейнеры"; dc ps -a --format "table {{.Service}}\t{{.Status}}"
    echo; echo "== Кто слушает порты 80/443/8080"; ss -tlnp 2>/dev/null | grep -E ':(80|443|8080|8443) ' || echo "никто"
    port=$(grep -m1 '^HTTP_PORT=' .env | cut -d= -f2- || true); port=${port:-80}
    echo; echo "== Ответ панели изнутри сервера (порт $port)"; curl -sS -m 5 -o /dev/null -w "HTTP %{http_code}\n" "http://localhost:$port" 2>&1 || true
    echo; echo "== Последние сообщения веб-сервера"; dc logs --tail 15 caddy 2>&1 | tail -15
    echo; echo "== Брандмауэр"; (ufw status 2>/dev/null || echo "ufw не установлен") | head -5
    echo; echo "Адрес: $(grep -m1 '^PUBLIC_BASE_URL=' .env | cut -d= -f2-)" ;;
  *)
    cat <<'HELP'
Команды VKreger:
  vk update    — обновить до последней версии (с резервной копией)
  vk restart   — перезапустить панель
  vk start     — запустить
  vk stop      — остановить
  vk status    — состояние и адрес панели
  vk logs      — логи в реальном времени (выход: Ctrl+C)
  vk backup    — резервная копия базы и картинок
  vk env       — изменить настройки (.env), например ключ OpenAI
  vk port 8080 — перенести панель на другой порт (если 80 занят)
  vk hostdomain [D] — HTTPS через уже установленный системный Caddy (по умолчанию бесплатный IP.sslip.io)
  vk domain D  — включить HTTPS на домене D (например 1-2-3-4.sslip.io); vk domain off — вернуть http по IP
  vk doctor    — диагностика: почему панель не открывается
HELP
    ;;
esac
